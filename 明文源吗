      [result.success ? result.latency + ' ms' : '—', result.success ? 'success' : 'muted'],
      [result.success ? (boot.fa ? result.colo : boot.datacenters[result.colo]) || result.colo || t('请求成功', 'درخواست موفق') : result.error, result.success ? '' : 'error-text']
